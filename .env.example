# Cohesion Portal Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# HubSpot Configuration (REQUIRED)
# =============================================================================
# Get this from HubSpot: Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Custom object type ID for p_client_projects
HUBSPOT_CUSTOM_OBJECT_TYPE=2-171216725

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Railway provides this automatically, or use local Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cohesion_portal

# =============================================================================
# Admin Access (REQUIRED)
# =============================================================================
# Password for staff to access /admin dashboard
ADMIN_API_KEY=your-admin-api-key-here

# =============================================================================
# Application URLs
# =============================================================================
FRONTEND_URL=http://localhost:5173

# Comma-separated origins for CORS. Include:
# - Your frontend URL (e.g. https://your-app.up.railway.app)
# - HubSpot for UIE card: https://app.hubspot.com,https://app-eu1.hubspot.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.hubspot.com,https://app-eu1.hubspot.com

# =============================================================================
# File Storage  ***PRODUCTION: MUST BE A RAILWAY VOLUME MOUNT PATH***
# =============================================================================
# Uploads are acknowledged to the client as soon as the file lands here, and
# pushed to HubSpot afterwards. On Railway's ephemeral container filesystem a
# redeploy during that window would destroy a document the client was already
# told had been submitted.
#
# Railway setup (one time):
#   1. Service > Settings > Volumes > add a volume, mount path e.g. /data
#   2. Set FILE_STORAGE_PATH=/data
# Files are deleted from the volume as soon as HubSpot confirms receipt, so a
# small volume is enough - it is a queue, not an archive.
#
# Note: a service with a volume cannot run multiple replicas, and its deploys
# take brief downtime (two deployments cannot mount the same volume at once).
FILE_STORAGE_PATH=./uploads

# Per-file upload ceiling in MB (default 50) and files per submission (default 15).
# Served to the frontend via GET /api/config, so changing it needs no frontend build.
# MUST stay at or below HubSpot's own Files API per-file limit.
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=15

# =============================================================================
# Node.js
# =============================================================================
NODE_ENV=development
PORT=3000
